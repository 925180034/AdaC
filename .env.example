ADACASCADE_RUNTIME_DIR=/data/xiaoyunhao/adacascade/runtime
ADACASCADE_FRONTEND_PORT=13000
DATABASE_URL=sqlite:///data/metadata.db
DATA_DIR=./data
CKPT_PATH=./data/ckpt.db
ARTIFACTS_DIR=./data/artifacts
QDRANT_URL=http://localhost:6333
AUTH_ENABLED=true
API_KEY=change-me
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:13000
DOCS_ENABLED=false
METRICS_ENABLED=false
MAX_UPLOAD_FILE_BYTES=104857600
MAX_UPLOAD_FILE_COUNT=50
MAX_ZIP_MEMBER_COUNT=200
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_EXCEL_SHEETS=50

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3.5:9b
LLM_MODEL_PATH=/data/xiaoyunhao/models/qwen3.5-9b-awq
LLM_TIMEOUT=120
LLM_ENABLE_THINKING=false

SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
SBERT_DEVICE=cuda:0
LOG_LEVEL=INFO

# HuggingFace mirror for regions where huggingface.co is unavailable
HF_ENDPOINT=https://hf-mirror.com

# Package/model mirrors for domestic network builds
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,qdrant

http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,qdrant

# Optional Docker image overrides for registry mirrors
PYTORCH_BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime
NODE_BASE_IMAGE=node:20-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.17.1
